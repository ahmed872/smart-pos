{
  "name": "cashier-system",
  "productName": "Cashier System",
  "version": "1.3.0",
  "description": "نظام نقطة بيع لسطح المكتب - إدارة مبيعات ومخزون وشاشة مطبخ",
  "main": "electron/main.js",
  "author": {
    "name": "Cashier System"
  },
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:dir": "electron-builder --win dir",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "exceljs": "^4.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "electron": "^42.11.8",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.cashiersystem.desktop",
    "productName": "Cashier System",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "package.json",
      "!**/node_modules/**/*.map",
      "!**/node_modules/**/*.{ts,mts,cts}",
      "!**/node_modules/**/{README,Readme,readme,CHANGELOG,Changelog,changelog,HISTORY,History,history,CONTRIBUTING,SECURITY,CODE_OF_CONDUCT,AUTHORS}{,.md,.markdown,.txt}",
      "!**/node_modules/better-sqlite3/{src,deps}/**"
    ],
    "copyright": "Copyright © 2026 Cashier System",
    "afterPack": "scripts/after-pack-fuses.js",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
