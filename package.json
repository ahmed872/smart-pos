{
  "name": "cashier-system",
  "productName": "Cashier System",
  "version": "1.1.0",
  "description": "نظام نقطة بيع لسطح المكتب - إدارة مبيعات ومخزون وشاشة مطبخ",
  "main": "electron/main.js",
  "author": "ahmed872",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:dir": "electron-builder --win dir",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "exceljs": "^4.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.cashiersystem.desktop",
    "productName": "Cashier System",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "afterPack": "scripts/after-pack-fuses.js",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
